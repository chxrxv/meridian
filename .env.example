# Auth option A: Gemini API key (local dev)
GEMINI_API_KEY=
# Auth option B: Vertex AI (Application Default Credentials; no key needed)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Models
MERIDIAN_MODEL=gemini-2.5-flash
MERIDIAN_EMBEDDING_MODEL=gemini-embedding-001

# RAG
MERIDIAN_STORE=chroma        # chroma | memory | vertex (vertex: optional, see docs)
MERIDIAN_EMBEDDER=hash       # hash (offline, deterministic) | gemini
MERIDIAN_GENERATOR=extractive  # extractive (offline) | gemini
